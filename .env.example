# Payload CMS Configuration
PAYLOAD_SECRET=your-super-secret-key-here
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Database Configuration
# For local development, you can use a local Postgres instance or Vercel Postgres
# Vercel will automatically set POSTGRES_URL in production
DATABASE_URI=postgresql://user:password@localhost:5432/portfolio
POSTGRES_URL=postgresql://user:password@localhost:5432/portfolio

# Vercel Blob Storage (for media uploads)
# Get this from Vercel Dashboard -> Storage -> Blob -> Connect
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxx

# Ghost Blog API
GHOST_CONTENT_API_KEY=your-ghost-content-api-key-here
